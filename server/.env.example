# ==============================================================
# DO-TODAY Server Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Never commit '.env' with real secrets to GitHub!
# ==============================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (auto-assigned by Render/Railway in production)
PORT=5000

# MongoDB Connection String
# Local dev: mongodb://127.0.0.1:27017/do-today
# Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/do-today?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/do-today

# JWT Secret Key (CRITICAL: Must be at least 32 characters in production!)
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars-long

# JWT Expiration time (e.g. '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated, no trailing slashes)
# Dev: http://localhost:5173,http://localhost:3000
# Production: https://your-frontend.vercel.app
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Storage Credentials (REQUIRED for persistent file attachments in production)
# Get these free from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


